# Copy to .env (never commit .env). All keys are optional; features degrade gracefully.
GEMINI_API_KEY=            # Google AI Studio key: assistant with Google Search grounding + AI extraction
GEMINI_MODEL=gemini-2.5-flash
YOUTUBE_API_KEY=           # YouTube Data API v3 (otherwise yt-dlp is used if installed)
TIKTOK_CLIENT_KEY=         # TikTok Research API (approved access)
TIKTOK_CLIENT_SECRET=
APIFY_TOKEN=               # Optional TikTok fallback via Apify
ADMIN_TOKEN=               # Protects "run" and moderation endpoints
ENRICH_INTERVAL_HOURS=24   # 0 disables the scheduler
ENRICH_MAX_PER_SOURCE=8
